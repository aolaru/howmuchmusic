---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Privacy Policy | How Much Music"
  description="Privacy policy for How Much Music, including aggregate analytics and contact email handling."
>
  <Breadcrumbs items={[{ label: "Home", href: baseUrl }, { label: "Privacy Policy" }]} />

  <section>
    <p class="eyebrow">Privacy</p>
    <h1>Privacy Policy</h1>
    <p>
      How Much Music is a public editorial website. This policy explains the basic data practices
      for aggregate analytics and messages sent through the contact page.
    </p>
  </section>

  <section>
    <h2>Aggregate Analytics</h2>
    <p>
      The site uses Cloudflare Web Analytics to understand aggregate traffic and page performance.
      The open-source archive does not load Google Analytics or advertising code.
    </p>
  </section>

  <section>
    <h2>Contact Messages</h2>
    <p>
      If you email the site, the message may include your email address, name, and any information
      you choose to send. That information is used to respond to the request, review corrections, or
      handle rights and source questions.
    </p>
  </section>

  <section>
    <h2>External Links</h2>
    <p>
      Pages may link to music platforms, Wikimedia Commons, Google services, or other external
      sources. Those sites have their own privacy policies and are not controlled by How Much Music.
    </p>
  </section>

  <section>
    <h2>Contact</h2>
    <p>
      Privacy questions can be sent to
      <a href="mailto:info@howmuchmusic.com">info@howmuchmusic.com</a>.
    </p>
  </section>
</BaseLayout>
