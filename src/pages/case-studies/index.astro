---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { caseStudies } from "../../data/caseStudies";
import { caseStudyTopicDefinitions, caseStudyTopicsBySlug } from "../../data/caseStudyTopics";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const popularQuestions = [
  {
    question: "How much does The Weeknd make a year?",
    detail: "Public success can be documented; verified personal income is not public.",
    slug: "the-weeknd-public-success-and-private-income"
  },
  {
    question: "How much did The Weeknd make from Blinding Lights?",
    detail: "Chart longevity is evidence of demand, not a public royalty total.",
    slug: "blinding-lights-chart-longevity"
  },
  {
    question: "How much does Travis Scott make a year?",
    detail: "Award and chart records identify work and scale, not personal receipts.",
    slug: "travis-scott-public-records-and-income-limits"
  },
  {
    question: "How much does Taylor Swift make a year?",
    detail: "Global chart recognition does not disclose private income or ownership terms.",
    slug: "taylor-swift-public-success-and-income-limits"
  },
  {
    question: "How much money did Queen make from Bohemian Rhapsody?",
    detail: "Multi-era chart history does not identify a royalty recipient or amount.",
    slug: "bohemian-rhapsody-reissues"
  },
  {
    question: "How much money did SICKO MODE make?",
    detail: "UK chart and award records do not disclose a revenue total or payment recipient.",
    slug: "sicko-mode-public-record-and-income-limits"
  }
];
---

<BaseLayout
  title="Music Rights Case Studies | How Much Music"
  description="Source-backed editorial case studies about music rights, chart evidence, catalog demand, and the limits of public earnings claims."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Editorial Case Studies</p>
      <h1>What public music records can, and cannot, prove.</h1>
      <p>
        These articles examine specific songs using visible chart, certification, award, and rights-framework sources.
        They do not turn popularity into invented royalty totals.
      </p>
    </div>
    <div class="hero-panel" aria-label="Case study standards">
      <p class="eyebrow">Publication Standard</p>
      <div class="hero-stat-pill hero-stat-pill-primary">
        <strong>{caseStudies.length}</strong>
        <span>source-backed case studies</span>
      </div>
      <div class="hero-stat-pill">
        <strong>3 links</strong>
        <span>minimum context on every page</span>
      </div>
    </div>
  </section>

  <section class="editorial-basis-card" aria-labelledby="popular-questions-title">
    <div class="editorial-basis-heading">
      <p class="eyebrow">Reader Questions</p>
      <h2 id="popular-questions-title">Start with the question, then check the evidence</h2>
      <p>
        These articles answer common earnings questions by separating public evidence from the private
        records that would be needed to verify an income claim.
      </p>
    </div>
    <div class="editorial-basis-grid">
      {popularQuestions.map((item) => (
        <article class="editorial-basis-item">
          <strong>Question</strong>
          <span><a href={`${baseUrl}case-studies/${item.slug}/`}>{item.question}</a></span>
          <span>{item.detail}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="case-study-filter-section" aria-labelledby="case-study-topics-title">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Browse By Topic</p>
        <h2 id="case-study-topics-title">Find the rights question you want to understand</h2>
      </div>
      <a class="home-action-link" href={`${baseUrl}evidence/`}>Open Evidence Library</a>
    </div>
    <p class="results-note">
      Topics describe the question examined in each article. They do not imply a financial conclusion about the artist or song.
    </p>
    <div class="case-study-filter-bar" data-case-study-filters aria-label="Filter case studies by topic">
      <button class="case-study-filter-button is-active" type="button" data-case-study-filter="all" aria-pressed="true">
        All studies <span>{caseStudies.length}</span>
      </button>
      {caseStudyTopicDefinitions.map((topic) => {
        const count = caseStudies.filter((study) => caseStudyTopicsBySlug[study.slug]?.includes(topic.id)).length;
        return (
          <button class="case-study-filter-button" type="button" data-case-study-filter={topic.id} aria-pressed="false">
            {topic.label} <span>{count}</span>
          </button>
        );
      })}
    </div>
    <p class="case-study-filter-summary" data-case-study-filter-summary aria-live="polite">
      Showing all {caseStudies.length} published case studies.
    </p>
  </section>

  <section aria-labelledby="case-studies-title">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Published Work</p>
        <h2 id="case-studies-title">Read a specific evidence question</h2>
      </div>
      <a class="home-action-link" href={`${baseUrl}editorial-policy/`}>Read editorial policy</a>
    </div>
    <p class="results-note">
      Each case identifies its evidence, explains the editorial reading, and states what the public record does not show.
    </p>
    <div class="card-grid case-study-grid" id="case-studies-grid">
      {caseStudies.map((caseStudy) => (
        <article class="card case-study-card" data-case-study-topics={caseStudyTopicsBySlug[caseStudy.slug]?.join(" ") ?? ""}>
          <div class="artist-card-body">
            <p class="eyebrow">{caseStudy.focus}</p>
            <h3><a href={`${baseUrl}case-studies/${caseStudy.slug}/`}>{caseStudy.title}</a></h3>
            <p class="card-byline">{caseStudy.artist}</p>
            <p>{caseStudy.summary}</p>
            <a class="home-action-link" href={`${baseUrl}case-studies/${caseStudy.slug}/`}>Read case study</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="editorial-basis-card" aria-labelledby="catalog-boundary-title">
    <div class="editorial-basis-heading">
      <p class="eyebrow">Catalog Boundary</p>
      <h2 id="catalog-boundary-title">The browseable catalog remains research material</h2>
      <p>
        Artist and song profiles remain available for discovery but are not presented here as completed reporting.
        They stay out of search indexing and advertising until they meet the publication standard.
      </p>
    </div>
    <div class="related-link-row">
      <a href={`${baseUrl}search/`}>Search catalog records</a>
      <a href={`${baseUrl}artists/`}>Browse artist records</a>
      <a href={`${baseUrl}songs/`}>Browse song records</a>
      <a href={`${baseUrl}contact/`}>Suggest a public source</a>
    </div>
  </section>

  <script is:inline>
    const filterBar = document.querySelector("[data-case-study-filters]");
    const filterButtons = Array.from(document.querySelectorAll("[data-case-study-filter]"));
    const caseStudyCards = Array.from(document.querySelectorAll("[data-case-study-topics]"));
    const filterSummary = document.querySelector("[data-case-study-filter-summary]");

    if (filterBar && filterSummary) {
      const selectTopic = (requestedTopic, updateLocation) => {
        const target = filterButtons.find((button) => button.dataset.caseStudyFilter === requestedTopic)
          ?? filterButtons.find((button) => button.dataset.caseStudyFilter === "all");
        if (!(target instanceof HTMLButtonElement)) return;

        const topic = target.dataset.caseStudyFilter ?? "all";
        let visibleCount = 0;

        for (const card of caseStudyCards) {
          const topics = card.getAttribute("data-case-study-topics")?.split(" ") ?? [];
          const isVisible = topic === "all" || topics.includes(topic);
          card.hidden = !isVisible;
          if (isVisible) visibleCount += 1;
        }

        for (const button of filterButtons) {
          const isActive = button === target;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        }

        const label = topic === "all"
          ? "all"
          : target.textContent?.replace(/\s+\d+\s*$/, "").trim() ?? "selected";
        filterSummary.textContent = `Showing ${visibleCount} ${label} case stud${visibleCount === 1 ? "y" : "ies"}.`;

        if (updateLocation) {
          const url = topic === "all"
            ? window.location.pathname
            : `${window.location.pathname}#${topic}`;
          window.history.replaceState(null, "", url);
        }
      };

      filterBar.addEventListener("click", (event) => {
        const target = event.target instanceof Element
          ? event.target.closest("[data-case-study-filter]")
          : null;
        if (target instanceof HTMLButtonElement) {
          selectTopic(target.dataset.caseStudyFilter ?? "all", true);
        }
      });

      window.addEventListener("hashchange", () => {
        selectTopic(window.location.hash.slice(1) || "all", false);
      });
      selectTopic(window.location.hash.slice(1) || "all", false);
    }
  </script>
</BaseLayout>
