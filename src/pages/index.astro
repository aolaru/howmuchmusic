---
import BaseLayout from "../layouts/BaseLayout.astro";
import { caseStudies } from "../data/caseStudies";
import { caseStudyTopicDefinitions } from "../data/caseStudyTopics";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const explainers = [
  {
    slug: "music-rights-map",
    title: "Follow the music rights map",
    detail: "See why a recording and its underlying song can move through separate rights lanes."
  },
  {
    slug: "streaming-payouts",
    title: "How streaming payouts work",
    detail: "Why a stream does not translate into one fixed payment to an artist."
  },
  {
    slug: "seasonal-songs",
    title: "Why seasonal songs return",
    detail: "Understand recurring demand without mistaking it for a disclosed royalty total."
  },
  {
    slug: "catalog-ownership",
    title: "What catalog ownership means",
    detail: "How masters, publishing, and catalog transfers affect who is paid."
  }
];

const researchAreas = [
  {
    topic: "seasonal",
    title: "Seasonal demand",
    detail: "Why a recurring cultural moment can bring an older recording back into public attention."
  },
  {
    topic: "demand",
    title: "Chart and long-tail demand",
    detail: "How public chart records can show durable attention without revealing a royalty total."
  },
  {
    topic: "rights",
    title: "Rights and ownership",
    detail: "Why the recording, the composition, and their owners should be read as separate questions."
  },
  {
    topic: "film",
    title: "Film and songwriting",
    detail: "How film and soundtrack context can be documented without guessing at private licensing terms."
  }
];
---

<BaseLayout
  title="How Much Music | The Public Record Behind Music Money"
  description="Source-led reporting on music rights, ownership, chart demand, and the limits of public income claims."
>
  <section class="hero home-hero">
    <div class="hero-copy">
      <p class="eyebrow">How Much Music</p>
      <h1>The public record behind music money.</h1>
      <p>
        How Much Music investigates what public charts, rights sources, and industry records can
        establish about a song's financial life. Start with a published question, then check the
        evidence and its limits.
      </p>
      <ul class="hero-proof-list" aria-label="Site approach">
        <li><strong>Sources</strong><span>explained on every editorial page</span></li>
        <li><strong>Limits</strong><span>private royalties are not presented as public facts</span></li>
        <li><strong>Corrections</strong><span>open to public source updates</span></li>
      </ul>
    </div>

    <div class="hero-panel home-search-panel" aria-label="Primary homepage actions">
      <p class="eyebrow">Start Here</p>
      <h2>Start with the question, not a guessed number.</h2>
      <div class="home-primary-actions">
        <article class="home-primary-action">
          <p class="eyebrow">1. Published Research</p>
          <h3>Read a source-backed case study</h3>
          <a class="home-action-link" href={`${baseUrl}case-studies/`}>Browse case studies</a>
        </article>
        <article class="home-primary-action">
          <p class="eyebrow">2. Rights Context</p>
          <h3>Follow the money path</h3>
          <a class="home-action-link" href={`${baseUrl}insights/music-rights-map/`}>Open the rights map</a>
        </article>
        <article class="home-primary-action">
          <p class="eyebrow">3. Evidence</p>
          <h3>See which sources support a claim</h3>
          <a class="home-action-link" href={`${baseUrl}evidence/`}>Open Evidence Library</a>
        </article>
      </div>
    </div>
  </section>

  <section aria-labelledby="case-studies-title">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Published Reporting</p>
        <h2 id="case-studies-title">Start with a source-backed case study</h2>
      </div>
      <a class="home-action-link" href={`${baseUrl}case-studies/`}>Open all case studies</a>
    </div>
    <p class="results-note">
      Each article examines one specific rights question, links the public record, and states what that record does not prove.
    </p>
    <div class="card-grid case-study-grid">
      {caseStudies.slice(0, 3).map((caseStudy) => (
        <article class="card case-study-card">
          <div class="artist-card-body">
            <p class="eyebrow">{caseStudy.focus}</p>
            <h3><a href={`${baseUrl}case-studies/${caseStudy.slug}/`}>{caseStudy.title}</a></h3>
            <p class="card-byline">{caseStudy.artist}</p>
            <p>{caseStudy.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="research-areas-title">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Research Areas</p>
        <h2 id="research-areas-title">Follow the question that matters to you</h2>
      </div>
      <a class="home-action-link" href={`${baseUrl}case-studies/`}>All research topics</a>
    </div>
    <p class="results-note">
      Each area groups case studies by the editorial question being investigated, not by a presumed payout.
    </p>
    <div class="editorial-grid">
      {researchAreas.map((area) => (
        <article class="card editorial-card">
          <div class="artist-card-body">
            <p class="eyebrow">{caseStudyTopicDefinitions.find((topic) => topic.id === area.topic)?.label}</p>
            <h3>{area.title}</h3>
            <p>{area.detail}</p>
            <a class="home-action-link" href={`${baseUrl}case-studies/#${area.topic}`}>Explore this question</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="editorial-guides-title">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Editorial Guides</p>
        <h2 id="editorial-guides-title">Start with a source-led explainer</h2>
      </div>
      <a class="home-action-link" href={`${baseUrl}insights/`}>Open all explainers</a>
    </div>
    <p class="results-note">
      These pages explain the relevant rights, evidence, and uncertainty behind the case-study approach.
    </p>
    <div class="card-grid reviewed-song-grid">
      {explainers.map((explainer) => (
        <article class="card artist-card reviewed-song-card">
          <div class="artist-card-body">
            <p class="eyebrow">Explainer</p>
            <h3><a href={`${baseUrl}insights/${explainer.slug}/`}>{explainer.title}</a></h3>
            <p>{explainer.detail}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="editorial-basis-card" aria-labelledby="catalog-use-title">
    <div class="editorial-basis-heading">
      <p class="eyebrow">Supporting Research</p>
      <h2 id="catalog-use-title">Use the catalog for context, not as a substitute for reporting</h2>
      <p>
        Artist and song profiles are useful navigation records. They are kept out of search indexing
        and advertising while their claims, sources, and model inputs are independently documented.
      </p>
    </div>
    <div class="related-link-row">
      <a href={`${baseUrl}artists/`}>Browse artists</a>
      <a href={`${baseUrl}songs/`}>Browse songs</a>
      <a href={`${baseUrl}search/`}>Search catalog</a>
      <a href={`${baseUrl}contact/`}>Suggest a source or correction</a>
    </div>
  </section>
</BaseLayout>
